__pycache__/
*.pyc
.venv/
venv/
.DS_Store

# ── licence signing key ───────────────────────────────────────────────────
# The development private key. Anyone holding it can mint a licence that a
# from-source build will accept, so it never goes near the repo. (A frozen
# build ignores the matching public key entirely — licensing/keys.py.)
devtools/dev-signing-key.hex
*-signing-key.hex

# sign_manifest.py's local, per-machine downgrade-protection bookkeeping —
# not shared state, and meaningless on any machine but the one that signed.
# One file per platform (devtools/.last_signed_update_version.<platform>)
# since 2026-08-31 — the glob covers both that and the old single-file
# name it replaced, so an un-migrated machine's leftover copy is still
# ignored too.
devtools/.last_signed_update_version*

# ── packaging output ──────────────────────────────────────────────────────
# All generated by packaging/build.py; nothing here is source.
build/
dist/
*.spec.bak
packaging/icons/
# Assembled downloads. The tarball is >100MB, which GitHub rejects outright —
# releases belong on the Releases page, not in the tree.
release/

# OAuth client for the Google Drive integration — never commit
integrations/google_client.json
integrations/token.json

# Agent skills installed with `npx skills add`. The skill BODIES are somebody
# else's repo at a pinned commit — skills-lock.json records which one, and is
# committed so everyone resolves the same set. Vendoring the folders as well
# would put thousands of lines of third-party prose in our diffs for no gain.
.agents/
.claude/skills/
