/* Prism GUI — "Soft Industry" theme
   Ported from the Claude Design project "Prism" (Prism.dc.html).
   theme.py mirrors the subset the custom-painted widgets need. Keep both in step.

   Palette
     canvas      #f4f5f6     card     #ffffff
     rail        #1d2d3d     (= accent ramp 900 — see below)
     ink         #1d1f20     divider  #d0d0d1  (16% ink)
     accent      #5980a6     ramp 100 #eef6ff … 600 #597ea3 … 800 #2c455d
     neutral     400 #b7b7ba  500 #98989b  600 #7a7a7d  700 #5d5d60  800 #424244
     semantic    ok #1DA487  warn #c9971f  err #8a2f2f   (never rotate)

   Shape: everything now carries a radius. This reverses the previous
   direction, which was square everywhere and cornered its panels with painted
   registration marks. Those marks are retired — a 3px accent stripe across the
   top of a card says "engineering" in a way that survives rounded corners,
   which the marks could not. widgets/blueprint.py is kept for the one place
   that still wants a drawn frame; nothing on the main path uses it.

   Depth: QSS has no box-shadow. Cards get their lift from
   QGraphicsDropShadowEffect via widgets.controls.elevate() — so a card's
   surface is styled here and its shadow in Python. Both read from theme.py.

   Role colour: every accent hex here is rewritten at load time by
   theme.role_stylesheet() so the whole app takes the signed-in role's hue.
   That includes the rail, which is deliberately accent-ramp-900 rather than a
   separate navy — a role that moved everything else but left a blue rail
   would look broken. The semantic and tool-brand colours are NOT in that list
   and must never be: "Won" stays green in every role.

   Type: Barlow for body, Barlow Condensed 600 for headings/buttons/labels.
   Both are vendored in assets/fonts and registered by theme.load_fonts().
   QSS has no letter-spacing property — the tracked labels (kickers, brand,
   window title) set it on their QFont in Python. */

* {
    font-family: "Barlow", "Inter", -apple-system, "Segoe UI", sans-serif;
    font-size: 14px;
    color: #1d1f20;
}

QMainWindow, QDialog {
    background: #f4f5f6;
}

/* Qt hands QDialogButtonBox platform icons — on GTK that's a red ✕ and a blue
   download arrow, which is the one place the desktop theme leaks through this
   one. Off everywhere; buttons in this system are text plus our own line
   icons or nothing. */
QDialogButtonBox {
    dialogbuttonbox-buttons-have-icons: 0;
}

QToolTip {
    background: #1d1f20;
    color: #f4f5f6;
    border: 1px solid #1d1f20;
    border-radius: 6px;
    padding: 5px 8px;
}

/* ── the card ────────────────────────────────────────────────────────────
   The surface this whole redesign is built out of. Painted by
   widgets.controls.Card, which also draws the optional accent stripe and
   attaches the drop shadow. */
#card {
    background: #ffffff;
    border-radius: 12px;
}

/* An inset well inside a card: the tool pill on a plan row, the "Prism's
   proposed change" strip on a reply. */
#well {
    background: #f7f8f9;
    border-radius: 8px;
}

/* Hairline between rows inside a card. Lighter than the canvas divider —
   it separates two things that are already on the same surface. */
#cardLine {
    background: #f0f0f1;
    max-height: 1px;
    min-height: 1px;
    border: none;
}

/* The vertical separator between the work column and the context rail. */
#railLine {
    background: #ececee;
    max-width: 1px;
    min-width: 1px;
    border: none;
}

/* ── sidebar ─────────────────────────────────────────────────────────────
   Dark. Everything inside it has to name its own colour, because the `*`
   rule above paints all text ink-on-light by default. */
#sidebar {
    background: #1d2d3d;
    border: none;
}

#sidebarInner {
    background: #1d2d3d;
}

#brand {
    font-family: "Barlow Condensed";
    font-size: 17px;
    font-weight: 600;
    color: #ffffff;
}

/* .navitem — a sidebar destination. Flat until hovered; the current one is
   lifted with a white wash rather than the accent tint it used to take, since
   on a dark rail an accent fill and the accent-coloured New-task button
   directly above it read as two primary actions. */
#navItem {
    text-align: left;
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 9px 12px;
    font-family: "Barlow";
    font-size: 13.5px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.75);
}

#navItem:hover {
    background: rgba(255, 255, 255, 0.07);
}

#navItem:pressed {
    background: rgba(255, 255, 255, 0.12);
}

#navItem[cur="true"] {
    background: rgba(255, 255, 255, 0.09);
    color: #ffffff;
}

/* The secondary rows — add-ons and the MORE group — sit one weight and one
   step of contrast below the primary destinations. */
#navSub {
    text-align: left;
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 7px 12px;
    font-family: "Barlow";
    font-size: 12.5px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.55);
}

#navSub:hover {
    background: rgba(255, 255, 255, 0.07);
    color: rgba(255, 255, 255, 0.85);
}

#navSub[cur="true"] {
    background: rgba(255, 255, 255, 0.09);
    color: #ffffff;
}

/* An add-on the licence doesn't cover. Quieter than a live item but NOT
   disabled — it stays clickable and opens the pitch for that add-on, because
   the click is the customer telling us what they want. A greyed-out control
   sells nothing and looks broken. */
#navItem[locked="true"], #navSub[locked="true"] {
    color: rgba(255, 255, 255, 0.32);
}

#navItem[locked="true"]:hover, #navSub[locked="true"]:hover {
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.55);
}

/* Shipped but not built yet. This one IS disabled — there is nothing behind
   the click — but it stays visible, because a shelf with a visible "next one"
   reads as a product line and an empty gap reads as an oversight. */
#navSub:disabled {
    color: rgba(255, 255, 255, 0.22);
}

#navSection {
    font-family: "Barlow Condensed";
    font-size: 11px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.32);
    padding: 2px 4px;
    background: transparent;
}

#railRule {
    background: rgba(255, 255, 255, 0.08);
    max-height: 1px;
    min-height: 1px;
    border: none;
}

#railMuted {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.45);
    background: transparent;
}

/* The New-task button: the rail's one filled control, and the only accent
   fill on the dark surface. Its shadow is attached in Python. */
#railPrimary {
    background: #5980a6;
    border: none;
    border-radius: 8px;
    color: #ffffff;
    font-family: "Barlow Condensed";
    font-weight: 600;
    font-size: 14px;
    padding: 10px 12px;
    text-align: center;
}

#railPrimary:hover { background: #658dae; }
#railPrimary:pressed { background: #597ea3; }

/* The licence card at the foot of the rail. */
#railCard {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
}

#railCardTitle {
    font-family: "Barlow Condensed";
    font-weight: 600;
    font-size: 13.5px;
    color: #ffffff;
    background: transparent;
}

#railCardBody {
    font-size: 11.5px;
    color: rgba(255, 255, 255, 0.5);
    background: transparent;
}

#railCardBtn {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 7px;
    color: #ffffff;
    font-family: "Barlow";
    font-size: 12px;
    font-weight: 500;
    padding: 6px;
}

#railCardBtn:hover { background: rgba(255, 255, 255, 0.08); }

/* The profile row, hard against the bottom edge. */
#railProfile {
    background: transparent;
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0;
    text-align: left;
    padding: 8px 6px;
}

#railProfile:hover { background: rgba(255, 255, 255, 0.05); }

#railProfileName {
    font-size: 12.5px;
    font-weight: 500;
    color: #ffffff;
    background: transparent;
}

#railProfileRole {
    font-size: 10.5px;
    color: rgba(255, 255, 255, 0.45);
    background: transparent;
}

#hr {
    background: #d0d0d1;
    max-height: 1px;
    min-height: 1px;
    border: none;
}

/* ── type roles ──────────────────────────────────────────────────────── */
#kick {
    font-family: "Barlow Condensed";
    font-size: 11.5px;
    font-weight: 600;
    color: #416180;
}

#kickMuted {
    font-family: "Barlow Condensed";
    font-size: 11.5px;
    font-weight: 600;
    color: #98989b;
}

#h1 { font-family: "Barlow Condensed"; font-size: 30px; font-weight: 600; }
#h2 { font-family: "Barlow Condensed"; font-size: 24px; font-weight: 600; }
#h3 { font-family: "Barlow Condensed"; font-size: 23px; font-weight: 600; }
#h4 { font-family: "Barlow Condensed"; font-size: 17px; font-weight: 600; }
#h5 { font-family: "Barlow Condensed"; font-size: 16px; font-weight: 600; }
#h6 { font-family: "Barlow Condensed"; font-size: 15px; font-weight: 600; }

/* The dashboard's big condensed figure — "12", "₹8.4L", "58%". */
#stat {
    font-family: "Barlow Condensed";
    font-weight: 600;
    font-size: 26px;
    color: #1d1f20;
}

#statSm {
    font-family: "Barlow Condensed";
    font-weight: 600;
    font-size: 22px;
    color: #1d1f20;
}

#meta, #dim {
    font-size: 12px;
    color: #7a7a7d;
}

/* The greyest legible step — timestamps, "· this week", row counts. */
#faint {
    font-size: 11.5px;
    color: #b7b7ba;
}

#body {
    font-size: 13px;
    color: #5d5d60;
}

#lead {
    font-size: 15px;
    color: #5d5d60;
}

/* Column headers in the inquiry register. */
#colHead {
    font-size: 11px;
    font-weight: 600;
    color: #98989b;
}

/* dashed advisory box (the "Tip." card in the context rail) */
#note {
    border: 1px dashed #e2e2e4;
    border-radius: 10px;
    padding: 13px;
    font-size: 12px;
    color: #98989b;
}

#emptyState {
    color: #98989b;
    font-size: 12.5px;
    padding: 20px 14px;
    background: transparent;
    border: 1px dashed #e2e2e4;
    border-radius: 10px;
}

/* ── buttons ─────────────────────────────────────────────────────────── */
/* Default is .btn-secondary: hairline box, condensed label, rounded. */
QPushButton {
    background: transparent;
    border: 1px solid #e7e7ea;
    border-radius: 8px;
    padding: 8px 14px;
    font-family: "Barlow";
    font-size: 13px;
    font-weight: 500;
    color: #424244;
}

QPushButton:hover {
    background: #f7f8f9;
    border-color: #d4d4d7;
}

QPushButton:pressed {
    background: #f0f0f1;
}

QPushButton:disabled {
    color: #b7b7ba;
    border-color: #f0f0f1;
}

#primaryBtn {
    background: #5980a6;
    border: 1px solid #5980a6;
    border-radius: 9px;
    color: #ffffff;
    padding: 10px 18px;
    font-family: "Barlow Condensed";
    font-size: 15px;
    font-weight: 600;
}

#primaryBtn:hover {
    background: #597ea3;
    border-color: #597ea3;
}

#primaryBtn:pressed {
    background: #416180;
    border-color: #416180;
}

/* Not greyed to a flat neutral: the button keeps its identity and simply
   loses weight, so it still reads as the thing to press once there is
   something to press it for. */
#primaryBtn:disabled {
    background: #c7d3dc;
    border-color: #c7d3dc;
    color: #ffffff;
}

#ghostBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #416180;
    padding: 6px 8px;
}

#ghostBtn:hover {
    background: rgba(89, 128, 166, 0.10);
}

#ghostBtn:pressed {
    background: rgba(89, 128, 166, 0.18);
}

#smallBtn {
    font-size: 12px;
    padding: 6px 12px;
    border-radius: 7px;
}

#iconBtn {
    background: #ffffff;
    border: 1px solid #e7e7ea;
    border-radius: 9px;
    padding: 0;
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
}

#iconBtn:hover {
    background: #f7f8f9;
}

/* .mic-lg — the composer's mic. Neutral until armed, then it goes red,
   because "recording" is a state you must be able to see from across a
   workshop and an accent-blue mic looks identical to every other control. */
#micBtn {
    background: transparent;
    border: 1px solid #e7e7ea;
    border-radius: 8px;
    padding: 8px 14px;
    font-family: "Barlow";
    font-size: 13px;
    font-weight: 500;
    color: #424244;
}

#micBtn:hover {
    background: #f7f8f9;
}

#micBtn:checked {
    background: #fdeeee;
    border-color: #eecccc;
    color: #8a2f2f;
}

#linkBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    color: #416180;
    font-family: "Barlow";
    font-size: 12.5px;
    font-weight: 500;
    padding: 5px 6px;
    text-align: left;
}

#linkBtn:hover {
    color: #2c455d;
    background: rgba(89, 128, 166, 0.10);
}

/* The quick-start chips on the hero card. */
#chipBtn {
    background: #fbfbfc;
    border: 1px solid #e7e7ea;
    border-radius: 999px;
    padding: 7px 14px;
    font-family: "Barlow";
    font-size: 12.5px;
    font-weight: 500;
    color: #424244;
}

#chipBtn:hover {
    border-color: #5980a6;
    color: #416180;
}

/* The segmented tab strip on Inquiry Automation. */
#tabStrip {
    background: #ffffff;
    border-radius: 10px;
}

#tabBtn {
    background: transparent;
    border: none;
    border-radius: 7px;
    padding: 8px 16px;
    font-family: "Barlow";
    font-size: 13px;
    font-weight: 600;
    color: #5d5d60;
}

#tabBtn:hover { background: #f7f8f9; }

#tabBtn[cur="true"] {
    background: #eef6ff;
    color: #2c455d;
}

/* The Settings section list. */
#secBtn {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    font-family: "Barlow";
    font-size: 13.5px;
    font-weight: 500;
    color: #424244;
    text-align: left;
}

#secBtn:hover { background: #f7f8f9; }

#secBtn[cur="true"] {
    background: #eef6ff;
    color: #2c455d;
}

/* ── inputs ──────────────────────────────────────────────────────────── */
QTextEdit, QLineEdit, QComboBox, QListWidget, QPlainTextEdit {
    background: #ffffff;
    border: 1px solid #e7e7ea;
    border-radius: 9px;
    padding: 8px 12px;
    color: #1d1f20;
    selection-background-color: #5980a6;
    selection-color: #ffffff;
}

QTextEdit:hover, QLineEdit:hover, QComboBox:hover {
    border-color: #d4d4d7;
}

/* Lists don't take the accent focus ring: a selected row already says where
   you are, and ringing the whole box reads as an error state. */
QTextEdit:focus, QLineEdit:focus, QComboBox:focus {
    border-color: #5980a6;
}

/* the task card's own editor sits *inside* the composer card, so it drops the
   second border and reads as bare text on the card */
#taskEdit {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
    font-size: 16px;
    color: #1d1f20;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #e7e7ea;
    border-radius: 9px;
    selection-background-color: #eef6ff;
    selection-color: #2c455d;
    padding: 3px;
}

QListWidget {
    padding: 3px;
}

QListWidget::item {
    padding: 7px 9px;
    border: none;
    border-radius: 7px;
}

QListWidget::item:hover {
    background: #f7f8f9;
}

QListWidget::item:selected {
    background: #eef6ff;
    color: #2c455d;
}

/* ── rows ────────────────────────────────────────────────────────────── */
/* A plan step / mention / stage. On the canvas these are their own small
   cards; inside a card they are transparent rows split by #cardLine. */
#row {
    background: #ffffff;
    border: none;
    border-radius: 11px;
}

#rowFlat {
    background: transparent;
    border: none;
    border-radius: 10px;
}

#rowFlat:hover {
    background: #f7f8f9;
}

#rowMuted {
    background: transparent;
    border: 1px solid #f0f0f1;
    border-radius: 10px;
}

/* the step marker painted by controls.StepMark */
#stepMark {
    background: #e7e7ea;
    border: none;
    border-radius: 6px;
}

#stepMark[on="true"] {
    background: #5980a6;
}

/* the big condensed 01 / 02 / 03 */
#stepNum {
    font-family: "Barlow Condensed";
    font-size: 30px;
    font-weight: 600;
    color: #416180;
}

/* The 1 Describe → 2 Plan → 3 Run breadcrumb. */
#stepCur {
    font-size: 12px;
    font-weight: 600;
    color: #416180;
}

#stepOff {
    font-size: 12px;
    font-weight: 600;
    color: #c2c2c5;
}

/* ── tags ────────────────────────────────────────────────────────────────
   Pills now. controls.Pill sets its own colours inline for the tones that
   vary by data; these object names remain for the fixed ones. */
#tagAccent, #tagOutline, #tagNeutral, #tagWarn, #tagErr, #tagOk {
    font-size: 11px;
    padding: 3px 11px;
    border-radius: 999px;
}

#tagAccent { background: #eef6ff; color: #2c455d; border: 1px solid #eef6ff; }
#tagOutline { border: 1px solid #5980a6; color: #416180; }
#tagNeutral { background: #f5f5f8; color: #424244; border: 1px solid #f5f5f8; }
#tagOk { background: #eafaf3; color: #1a7a5e; border: 1px solid #eafaf3; }
#tagWarn { background: #fff8e8; color: #8a6d1f; border: 1px solid #fff8e8; }
#tagErr { background: #fdeeee; color: #8a2f2f; border: 1px solid #fdeeee; }

/* ── output stage body ───────────────────────────────────────────────── */
#stageBody {
    background: #f7f8f9;
    border: none;
    border-radius: 8px;
    padding: 12px;
    font-size: 13px;
    color: #5d5d60;
}

/* ── checkbox ────────────────────────────────────────────────────────── */
QCheckBox {
    color: #1d1f20;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #d4d4d7;
    border-radius: 5px;
    background: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #5980a6;
}

QCheckBox::indicator:checked {
    background: #5980a6;
    border: 1px solid #5980a6;
    /* %ASSETS% is rewritten to an absolute path by main.py — a bare relative
       url() would resolve against the process's cwd, not the app. */
    image: url(%ASSETS%/check.svg);
}

/* ── groupbox (setup dialogs) ────────────────────────────────────────── */
QGroupBox {
    background: transparent;
    border: 1px solid #e7e7ea;
    border-radius: 10px;
    margin-top: 14px;
    padding-top: 14px;
    font-family: "Barlow Condensed";
    font-size: 15px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 11px;
    padding: 0 6px;
    color: #416180;
}

/* ── scrollbars ──────────────────────────────────────────────────────── */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 9px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #d4d4d7;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #b7b7ba;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QScrollBar:horizontal { height: 0; }

QSplitter::handle { background: #ececee; }

/* ── chrome ──────────────────────────────────────────────────────────── */
QStatusBar {
    background: #f4f5f6;
    color: #98989b;
    border-top: 1px solid #ececee;
    font-size: 12px;
}

QStatusBar::item { border: none; }

QMenu {
    background: #ffffff;
    border: 1px solid #e7e7ea;
    border-radius: 9px;
    padding: 4px;
}

QMenu::item {
    padding: 7px 20px 7px 12px;
    border-radius: 6px;
}

QMenu::item:selected {
    background: #eef6ff;
    color: #2c455d;
}

QMenu::separator {
    height: 1px;
    background: #f0f0f1;
    margin: 4px 0;
}
